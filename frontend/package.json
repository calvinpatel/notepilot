{
  "name": "notepilot-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../tests/snapshots/openapi.json --output src/api.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
