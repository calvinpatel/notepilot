ANTHROPIC_API_KEY=
# Knobs (spec §10). Uncomment to override; values shown are the defaults. MODEL and
# MODEL_MAX_OUTPUT_TOKENS are left out: they change together, at a pin the smoke run
# verifies (L72, L85).
# MAX_INPUT_CHARS=12500
# MIN_INPUT_CHARS=20
# OUTPUT_TOKENS_PER_INPUT_CHAR=1.6
# MAX_VALIDATION_RETRIES=2
# SDK_TRANSPORT_RETRIES=2
# LLM_TIMEOUT_S=90.0
# JUDGE_ENABLED=False
# JUDGE_TIMEOUT_S=15.0
# JUDGE_CONCURRENCY=4
# FUZZY_SCORE_CUTOFF=90.0
# MIN_QUOTE_CONTENT_TOKENS=2
# CORPUS_REPEATS=3
# CORPUS_CONCURRENCY=1
# RUNS_PATH=backend/evals/runs/corpus_runs.jsonl
# PERSIST_ENABLED=False
# With PERSIST_ENABLED=True, set DATABASE_URL to a postgresql+asyncpg:// URL.
# RATE_LIMIT and DAILY_TOKEN_BUDGET are unset here, so a local run has no limiter and no cap.
# The deploy sets both, with MAX_VALIDATION_RETRIES=0 and the judge off (L332, L348).
# What python -m backend.serve hands uvicorn (L352). The deploy sets HOST=0.0.0.0, and
# FORWARDED_ALLOW_IPS to the platform proxy's range, never *.
# HOST=127.0.0.1
# PORT=8000
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
